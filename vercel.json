{
  "buildCommand": "npm run build:main",
  "outputDirectory": "main/frontend/dist",
  "redirects": [
    {
      "source": "/crm",
      "destination": "https://frontend-ilot.vercel.app/crm/login",
      "permanent": false
    },
    {
      "source": "/crm/(.*)",
      "destination": "https://frontend-ilot.vercel.app/crm/$1",
      "permanent": false
    },
    {
      "source": "/fitscalez/crm",
      "destination": "https://frontend-ilot.vercel.app/crm/login",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://walktheplan-backend.onrender.com/api/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "https://walktheplan-backend.onrender.com/uploads/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
